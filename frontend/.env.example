# Base URL the browser uses for API calls.
# Leave as /api/v1 in development (Vite proxies it to the backend).
# In production set the full API URL, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server proxies /api and /images
VITE_DEV_BACKEND_URL=http://localhost:8000
