{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://project-management-o65w.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://project-management-o65w.onrender.com/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
