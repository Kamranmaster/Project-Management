# ---------- Server ----------
PORT=8000
# Set to "production" in production (enables Secure cookies)
NODE_ENV=development
# Comma-separated list of allowed browser origins (the frontend URL)
CORS_ORIGIN=http://localhost:5173
# Public base URL of this API, used to build attachment URLs (/images/...)
SERVER_URL=http://localhost:8000

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/project-camp

# ---------- JWT ----------
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d

# ---------- Email (Mailtrap SMTP) ----------
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=

# ---------- Frontend links used in emails ----------
# Reset link = FORGOT_PASSWORD_REDIRECT_URL/<token>
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
# Verification link = EMAIL_VERIFICATION_REDIRECT_URL/<token>
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:5173/verify-email
